---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { formatRange, getResume } from '../../lib/resume';

const { experience, projects } = await getResume();
const roles = experience.toSorted((a, b) => b.start.valueOf() - a.start.valueOf());

// Mirrors `.projects` below: full-width stack on small screens, fixed-width row above.
const cardWidth = '16rem';
const cardSizes = `(width < 48rem) 100vw, ${cardWidth}`;
---

<Base title="Work" subtitle="To grow.">
  <p class="preface">
    I've noticed I don't really fit into any particular role perfectly. I'm a natural polymath
    interested in all manner of knowledge from physics to literature to computer science to
    philosophy. Drawing patterns from the intersection of all reality is what helps me come up with
    realistic insight that isn't tunnel-visioned. I read in the science of learning that
    cross-discplinary knowledge is where true innovation lies.
  </p>
  <section aria-labelledby="experience">
    <ol class="timeline">
      {
        roles.map((role) => (
          <li class="role">
            <h3 class="role-title">
              {role.title} at <a class="company" href={role.company.url} target="_blank" rel="noopener noreferrer">{role.company.name}</a>
            </h3>
            <p class="meta">{formatRange(role.start, role.end)}</p>
            <p class="summary">{role.summary}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="projects">
    <ul class="projects">
      {
        projects.map((project) => (
          <li>
            <ProjectCard project={project} sizes={cardSizes} />
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style define:vars={{ cardWidth }}>
  section + section {
    margin-top: var(--space-16);
  }

  .preface {
    margin-bottom: var(--space-16);
  }

  /* Timeline: hollow dots on a continuous rail. */
  .timeline {
    --dot: var(--space-4);

    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin: 0;
    padding: 0;
    list-style: none;

    &::before {
      content: '';
      position: absolute;
      top: var(--space-3);
      bottom: 0;
      left: calc((var(--dot) - var(--border-thick)) / 2);
      width: var(--border-thick);
      background: var(--rule-color);
    }
  }

  .role {
    position: relative;
    padding-left: calc(var(--dot) + var(--space-6));

    &::before {
      content: '';
      position: absolute;
      top: var(--space-2);
      left: 0;
      box-sizing: border-box;
      width: var(--dot);
      height: var(--dot);
      border: var(--border-thick) solid var(--rule-color);
      border-radius: var(--radius-full);
      background: var(--background);
    }
  }

  .role-title {
    font-family: var(--font-body);
    font-size: var(--text-2xl);
    font-weight: var(--weight-medium);
    line-height: var(--leading-tight);
  }

  .company {
    color: var(--link);
  }

  .role .meta {
    margin: var(--space-2) 0 0;
  }

  .summary {
    margin: var(--space-3) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-light);
  }

  /*
   * Small screens: single-column stack so every card is fully visible.
   * Larger screens: horizontally scrolling row of fixed-width cards; padding leaves room for the hover lift and shadow.
   */
  .projects {
    --bleed: var(--space-3);
    --lift-room: var(--space-6);

    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;

    @media (--md) {
      grid-auto-flow: column;
      grid-auto-columns: var(--cardWidth);
      gap: var(--space-3);
      margin: calc(var(--lift-room) * -1) calc(var(--bleed) * -1);
      padding: var(--lift-room) var(--bleed);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--bleed);

      li {
        scroll-snap-align: start;
      }
    }
  }
</style>
