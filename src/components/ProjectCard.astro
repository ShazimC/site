---
import { Image } from 'astro:assets';
import ExternalIcon from '@phosphor-icons/core/assets/light/arrow-square-out-light.svg';
import GithubIcon from '@phosphor-icons/core/assets/light/github-logo-light.svg';
import ProductHuntIcon from '../assets/icons/producthunt.svg';
import { projectTransition, type Project } from '../lib/resume';

interface Props {
  project: Project;
  /** Rendered image width per breakpoint; the parent owns the layout, so it supplies this. */
  sizes: string;
}

/* The name's link is stretched over the whole card to open the project's site; the icon links sit above it. */
const { project, sizes } = Astro.props;
const { name, url, github, productHunt, image, description } = project;

const links = [
  productHunt && { href: productHunt, label: `${name} on Product Hunt`, Icon: ProductHuntIcon },
  { href: url, label: `Open ${name}`, Icon: ExternalIcon },
  github && { href: github, label: `${name} on GitHub`, Icon: GithubIcon },
].filter((link) => !!link);
---

<article class="project">
  {
    image && (
      <div class="cover">
        <Image src={image} alt="" widths={[320, 640, 960]} {sizes} />
      </div>
    )
  }
  <div class="header">
    <h3
      class="name morph"
      transition:name={projectTransition(project.post.id)}
      transition:animate="initial"
    >
      <a
        href={url}
        class="main pen-none"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${name} (opens in a new tab)`}>{name}</a
      >
    </h3>
    <ul class="links">
      {
        links.map(({ href, label, Icon }) => (
          <li>
            <a
              {href}
              class="pen-none"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${label} (opens in a new tab)`}
              title={label}
            >
              <Icon class="icon" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <p class="description">{description}</p>
</article>

<style>
  /* Layout and motion after maggieappleton.com's essay cards. Fluid: fills whatever width the parent gives it. */
  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    block-size: 100%;
    padding: var(--space-5);
    border: var(--border-thin) solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    color: var(--text);
    transition:
      transform var(--duration-normal) var(--ease-spring),
      box-shadow var(--duration-fast) var(--ease);

    &:has(.main:focus-visible) {
      transform: scale(var(--scale-lift));
      box-shadow: var(--shadow-lifted);
    }

    @media (--can-hover) {
      &:hover {
        transform: scale(var(--scale-lift));
        box-shadow: var(--shadow-lifted);
      }
    }

    &:has(.main:active) {
      transform: none;
      transition-duration: var(--duration-fast);
    }
  }

  .cover {
    aspect-ratio: 1;
    margin-bottom: var(--space-3);
    overflow: hidden;
    border-radius: var(--radius-sm);

    img {
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
    }
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .name {
    font-family: var(--font-body);
    font-size: var(--text-2xl);
    font-weight: var(--weight-medium);
    line-height: var(--leading-tight);
  }

  /* Static so the stretched ::after positions against the card, not the link (pen.css makes links relative). */
  .main {
    position: static;
    color: inherit;

    /* Stretches the link over the card so the whole card opens the link; `all: unset` drops pen.css's stroke styles. */
    &::after {
      all: unset;
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
    }

    /* The card draws the focus ring instead. */
    &:focus-visible {
      outline: none;
    }
  }

  .project:has(.main:focus-visible) {
    outline: var(--border-thick) solid var(--link);
    outline-offset: var(--border-thick);
  }

  .links {
    position: relative;
    z-index: 1;
    display: flex;
    /* Cancels the links' hit-area padding so icons align with the card edge and don't heighten the title line. */
    margin: calc(-1 * var(--space-1));
    padding: 0;
    list-style: none;

    a {
      display: grid;
      place-items: center;
      padding: var(--space-1);
      border-radius: var(--radius-sm);
      color: var(--text-muted);
      transition: color var(--duration-normal) var(--ease);

      &:focus-visible {
        color: var(--link);
      }

      @media (--can-hover) {
        &:hover {
          color: var(--link);
        }
      }
    }
  }

  .icon {
    inline-size: var(--text-2xl);
    block-size: var(--text-2xl);
  }

  .description {
    margin: var(--space-2) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--weight-light);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .project,
    .links a {
      transition: none;
    }
  }
</style>
