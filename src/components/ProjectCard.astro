---
import { Image } from 'astro:assets';
import type { Project } from '../lib/resume';

interface Props {
  project: Project;
  /** Rendered image width per breakpoint; the parent owns the layout, so it supplies this. */
  sizes: string;
}

const { project, sizes } = Astro.props;
const { name, url, image, description } = project;
---

<a href={url} target="_blank" rel="noopener noreferrer" class="project pen-none">
  {
    image && (
      <div class="cover">
        <Image src={image} alt="" widths={[320, 640, 960]} {sizes} />
      </div>
    )
  }
  <h3 class="name">{name}</h3>
  <p class="description">{description}</p>
</a>

<style>
  /* Layout and motion after maggieappleton.com's essay cards. Fluid: fills whatever width the parent gives it. */
  .project {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    block-size: 100%;
    padding: var(--space-5);
    border: var(--border-thin) solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    color: var(--text);
    transition:
      transform var(--duration-normal) var(--ease-spring),
      box-shadow var(--duration-fast) var(--ease);

    &:focus-visible {
      transform: scale(var(--scale-lift));
      box-shadow: var(--shadow-lifted);
    }

    @media (--can-hover) {
      &:hover {
        transform: scale(var(--scale-lift));
        box-shadow: var(--shadow-lifted);
      }
    }

    &:active {
      transform: none;
      transition-duration: var(--duration-fast);
    }
  }

  .cover {
    aspect-ratio: 1;
    margin-bottom: var(--space-3);
    overflow: hidden;
    border-radius: var(--radius-sm);

    img {
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
    }
  }

  .name {
    font-family: var(--font-body);
    font-size: var(--text-2xl);
    font-weight: var(--weight-medium);
    line-height: var(--leading-tight);
    transition: color var(--duration-fast) var(--ease);

    .project:focus-visible &,
    .project:active & {
      color: var(--link);
    }

    @media (--can-hover) {
      .project:hover & {
        color: var(--link);
      }
    }
  }

  .description {
    margin: var(--space-2) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--weight-light);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .project,
    .name {
      transition: none;
    }
  }
</style>
