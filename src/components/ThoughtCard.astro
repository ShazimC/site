---
import ThoughtMeta from './ThoughtMeta.astro';
import { thoughtTransition, type Thought } from '../lib/thoughts';

interface Props {
  thought: Thought;
}

const { thought } = Astro.props;
const { title, description } = thought.data;
---

<a href={`/thoughts/${thought.id}/`} class="thought hover-item pen-none">
  <ThoughtMeta thought={thought} />
  <h2
    class="title hover-title morph"
    transition:name={thoughtTransition(thought.id)}
    transition:animate="initial"
  >
    {title}
  </h2>
  <p class="description">{description}</p>
</a>

<style>
  .thought {
    display: block;
    color: inherit;
  }

  .thought :global(.meta) {
    margin: 0 0 var(--space-3);
  }

  .title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-regular);
    line-height: var(--leading-tight);
  }

  .description {
    margin: var(--space-2) 0 0;
    color: var(--text-muted);
  }
</style>
