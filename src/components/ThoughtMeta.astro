---
import { formatDate, readingTime, type Thought } from '../lib/thoughts';

interface Props {
  thought: Thought;
}

const { thought } = Astro.props;
const { date, complete } = thought.data;
---

<p class="meta">
  <!-- <span aria-hidden="true">·</span> -->
  <!-- <span>{readingTime(thought.body)}</span> -->
  {
    !complete && (
      <>
        <em class="rough" title="Unfinished thinking, still taking shape">
          Draft
        </em>
        <span aria-hidden="true">·</span>
      </>
    )
  }

  <time datetime={date.toISOString()}>{formatDate(date)}</time>
</p>

<style>
  .meta {
    align-items: baseline;
  }

  /* A handwritten-feeling aside in the sans meta line: serif italic. */
  .rough {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--weight-regular);
    color: var(--text-muted);
  }
</style>
