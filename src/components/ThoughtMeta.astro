---
import { formatDate, readingTime, type Thought } from '../lib/thoughts';

interface Props {
  thought: Thought;
}

const { thought } = Astro.props;
const { date, rough } = thought.data;
---

<p class="meta">
  <time datetime={date.toISOString()}>{formatDate(date)}</time>
  <!-- <span aria-hidden="true">·</span> -->
  <!-- <span>{readingTime(thought.body)}</span> -->
  {
    rough && (
      <>
        <span aria-hidden="true">·</span>
        <em class="rough" title="Unfinished thinking, still taking shape">
          Draft
        </em>
      </>
    )
  }
</p>

<style>
  .meta {
    align-items: baseline;
  }

  /* A handwritten-feeling aside in the uppercase sans meta line: serif italic, lowercase, accent ink.
     No separator dot, so it reads cleanly whether it trails the line or wraps below it. */
  .rough {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    text-transform: none;
    letter-spacing: normal;
    color: var(--link);
  }
</style>
