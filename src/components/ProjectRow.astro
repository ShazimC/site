---
import ExternalIcon from '@phosphor-icons/core/assets/light/arrow-square-out-light.svg';
import GithubIcon from '@phosphor-icons/core/assets/light/github-logo-light.svg';
import ProductHuntIcon from '../assets/icons/producthunt.svg';
import { projectHref, projectTransition, type Project } from '../lib/resume';

interface Props {
  project: Project;
}

/* Name and description open the project's write-up; icons beside the name link out. */
const { project } = Astro.props;
const { name, url, github, productHunt, description } = project;

const links = [
  { href: url, label: `Open ${name}`, Icon: ExternalIcon },
  github && { href: github, label: `${name} on GitHub`, Icon: GithubIcon },
  productHunt && { href: productHunt, label: `${name} on Product Hunt`, Icon: ProductHuntIcon },
].filter((link) => !!link);
---

<article class="row">
  <a href={projectHref(project)} class="main hover-item pen-none">
    <h3
      class="name hover-title morph"
      transition:name={projectTransition(project.post.id)}
      transition:animate="initial"
    >
      {name}
    </h3>
    <p class="description">{description}</p>
  </a>
  <ul class="links">
    {
      links.map(({ href, label, Icon }) => (
        <li>
          <a
            {href}
            class="pen-none"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${label} (opens in a new tab)`}
            title={label}
          >
            <Icon class="icon" aria-hidden="true" />
          </a>
        </li>
      ))
    }
  </ul>
</article>

<style>
  /*
   * Two-column grid: the main link spans both columns (subgrid) so the description runs full width,
   * while the icon links sit in the empty top-right cell, beside the title and outside the link.
   */
  .row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-4);
  }

  .main {
    display: grid;
    grid-column: 1 / -1;
    grid-row: 1 / -1;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
    color: inherit;
  }

  .name {
    font-size: var(--text-xl);
    font-weight: var(--weight-regular);
    line-height: var(--leading-tight);
  }

  .description {
    grid-column: 1 / -1;
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: var(--weight-regular);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  .links {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    display: flex;
    /* Cancels the links' hit-area padding so icons align with the row edge and don't heighten the title line. */
    margin: calc(-1 * var(--space-1));
    padding: 0;
    list-style: none;

    a {
      display: grid;
      place-items: center;
      padding: var(--space-1);
      border-radius: var(--radius-sm);
      color: var(--text-muted);
      transition: color var(--duration-normal) var(--ease);

      &:focus-visible {
        color: var(--primary);
      }

      @media (--can-hover) {
        &:hover {
          color: var(--primary);
        }
      }
    }
  }

  .icon {
    inline-size: var(--text-xl);
    block-size: var(--text-xl);
  }

  @media (prefers-reduced-motion: reduce) {
    .links a {
      transition: none;
    }
  }
</style>
