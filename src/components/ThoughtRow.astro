---
import ThoughtMeta from './ThoughtMeta.astro';
import { thoughtTransition, type Thought } from '../lib/thoughts';

interface Props {
  thought: Thought;
}

/* Compact counterpart to ThoughtCard: title, date and description, for short lists. */
const { thought } = Astro.props;
const { title, description } = thought.data;
---

<a href={`/thoughts/${thought.id}/`} class="row hover-item pen-none">
  <h3
    class="title hover-title morph"
    transition:name={thoughtTransition(thought.id)}
    transition:animate="initial"
  >
    {title}
  </h3>
  <ThoughtMeta thought={thought} />
  {description && <p class="description">{description}</p>}
</a>

<style>
  /* Stacked on small screens; title and date share a line from --sm up, description spans below. */
  .row {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-4);
    color: inherit;

    @media (--sm) {
      grid-template-columns: 1fr auto;
      align-items: baseline;
      column-gap: var(--space-6);
    }
  }

  .description {
    grid-column: 1 / -1;
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: var(--weight-regular);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  .title {
    font-size: var(--text-xl);
    font-weight: var(--weight-regular);
    line-height: var(--leading-tight);
  }

  .row :global(.meta) {
    margin: 0;
  }
</style>
